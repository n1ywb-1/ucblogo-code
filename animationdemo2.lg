animationstop
showturtle
pu
cs

to animate :td
    make "oldx first pos
    make "oldy first bf pos
    make "oldh heading
    clean
    pd
    repeat 16 [fd # * 20 rt 90]
    pu
    setheading :oldh + :td / 20
    setx :oldx + :td / 10
    sety :oldy + :td / 10
end

make "animationact [animate :animationdelta]

animationstart
