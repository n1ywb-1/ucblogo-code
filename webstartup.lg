to runjs :js
    localmake "oldwriter writer
    openwrite "/dev/runjs
    setwrite "/dev/runjs
    pr :js
    close "/dev/runjs
    setwrite :oldwriter
    op readword
end
bury "runjs

to setshaperendering :mode
if not member? :mode [geometricprecision crispedges optimizespeed] [
    (pr :mode [must be one of geometricprecision crispedges or optimizespeed])
    stop
]
ignore runjs (word "|document.getElementById('logoDrawing').style.setProperty('shape-rendering', '| :mode "|')|)
end
bury "setshaperendering

;to animate
;ignore runjs "|new Promise((res,rej)=>window.requestAnimationFrame(res))|
;end
;bury "animate

; to animationframe :words
; op runjs "|new Promise((res,rej)=>window.requestAnimationFrame(res)).then(runLogo())|
; end
; bury "animationframe

to makesprite :spritename
ignore runjs apply "word `[Module.makeSprite(' ,:spritename ')]
end

to setturtlesprite :spritename
ignore runjs apply "word `[Module.setTurtle(' ,:spritename ')]
end

pr [Web Edition Preview]
pr []
