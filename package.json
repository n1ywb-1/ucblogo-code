{
  "name": "ucblogo",
  "version": "6.2.5-WASM-preview-42",
  "description": "## Berkeley Logo interpreter",
  "main": "ucblogo.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "npm run test:settings && npm run test:lighthouse",
    "test:settings": "./emscript.sh && mocha tests/acceptance/settings-persistence.test.js tests/acceptance/error-reporting.test.js",
    "test:settings:built": "mocha tests/acceptance/settings-persistence.test.js tests/acceptance/error-reporting.test.js",
    "test:settings:chrome": "BROWSERS=chrome npm run test:settings",
    "test:settings:firefox": "BROWSERS=firefox npm run test:settings",
    "test:lighthouse": "mocha tests/acceptance/lighthouse.test.js",
    "test:ipad:remote": "testcafe remote tests/acceptance/ipad-keyboard.test.js --ports 38079,38080 --disable-native-automation",
    "test:autocomplete": "npm run -s test:autocomplete:desktop && npm run -s test:autocomplete:phone",
    "test:autocomplete:desktop": "testcafe ${TESTCAFE_BROWSER:-chrome} tests/acceptance/autocomplete.testcafe.js --app 'emrun --no-browser --port 8085 ucblogo.html' --app-init-delay 3000 -s path=reports --assertion-timeout 2000 --selector-timeout 2000",
    "test:autocomplete:phone": "testcafe 'chrome:emulation:width=390;height=500;mobile=true;touch=true' tests/acceptance/autocomplete.testcafe.js --app 'emrun --no-browser --port 8085 ucblogo.html' --app-init-delay 3000 -s path=reports --assertion-timeout 2000 --selector-timeout 2000"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "chai": "^6.3.0",
    "lighthouse": "^13.6.0",
    "mocha": "^12.0.3",
    "selenium-webdriver": "^4.51.0",
    "testcafe": "^3.7.7",
    "workbox-cli": "^7.3.0"
  }
}
